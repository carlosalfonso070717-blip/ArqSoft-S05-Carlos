@model CitasApp.Domain.Models.Cita
@{
    ViewData["Title"] = "Nueva Cita";
    var pacientes = ViewBag.Pacientes as List<CitasApp.Domain.Models.Paciente>;
    var medicos = ViewBag.Medicos as List<CitasApp.Domain.Models.Medico>;
}

<div class="page-header">
    <h1>➕ Agendar Nueva Cita</h1>
    <p>Complete el formulario para programar una nueva cita médica</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <span class="section-icon">📝</span>
                Formulario de Agendamiento
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="PacienteId" class="form-label">Paciente</label>
                        <select asp-for="PacienteId" class="form-select" required>
                            <option value="">-- Seleccione un paciente --</option>
                            @if (pacientes != null)
                            {
                                foreach (var paciente in pacientes)
                                {
                                    <option value="@paciente.Id">@paciente.Nombre @paciente.Apellido (@paciente.Email)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="PacienteId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MedicoId" class="form-label">Médico</label>
                        <select asp-for="MedicoId" class="form-select" required>
                            <option value="">-- Seleccione un médico --</option>
                            @if (medicos != null)
                            {
                                foreach (var medico in medicos)
                                {
                                    <option value="@medico.Id">@medico.Nombre @medico.Apellido - @medico.Especialidad</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="MedicoId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Fecha" class="form-label">Fecha</label>
                            <input asp-for="Fecha" class="form-control" type="date" required />
                            <span asp-validation-for="Fecha" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Hora" class="form-label">Hora</label>
                            <input asp-for="Hora" class="form-control" type="time" required />
                            <span asp-validation-for="Hora" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Motivo" class="form-label">Motivo de la Consulta</label>
                        <textarea asp-for="Motivo" class="form-control" rows="3" placeholder="Describa el motivo de la consulta..." required></textarea>
                        <span asp-validation-for="Motivo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label">Estado</label>
                        <select asp-for="Estado" class="form-select" required>
                            <option value="Pendiente">⏳ Pendiente</option>
                            <option value="Confirmada">✓ Confirmada</option>
                            <option value="Cancelada">✗ Cancelada</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            💾 Agendar Cita
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            ← Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
