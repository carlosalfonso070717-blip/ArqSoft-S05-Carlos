@model List<Citas_App.Models.Cita>
@using Citas_App.Models

@{
    var pacientes = ViewBag.Pacientes as List<Paciente>;
    var medicos = ViewBag.Medicos as List<Medico>;
    var primero = Model.FirstOrDefault();
    var paciente = pacientes?.FirstOrDefault(p => p.Id == primero?.PacienteId);
}

<h1>Citas de @(paciente != null ? $"{paciente.Nombre} {paciente.Apellido}" : "paciente")</h1>
<table border="1" cellpadding="8">
    <tr>
        <th>Fecha</th>
        <th>Hora</th>
        <th>Médico</th>
        <th>Motivo</th>
        <th>Estado</th>
    </tr>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Fecha</td>
            <td>@c.Hora</td>
            <td>@(medicos?.FirstOrDefault(m => m.Id == c.MedicoId)?.Nombre ?? "N/A")</td>
            <td>@c.Motivo</td>
            <td>@c.Estado</td>
        </tr>
    }
</table>
<a asp-controller="Paciente" asp-action="Index">← Volver a pacientes</a>
