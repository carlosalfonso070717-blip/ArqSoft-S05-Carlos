@model Citas_App.Models.Medico
@{
    ViewData["Title"] = "Nuevo Médico";
}

<div class="page-header">
    <h1>➕ Registrar Nuevo Médico</h1>
    <p>Complete el formulario con los datos del médico</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <span class="section-icon">📝</span>
                Formulario de Registro
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombre" class="form-label">Nombre</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Roberto" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Apellido" class="form-label">Apellido</label>
                            <input asp-for="Apellido" class="form-control" placeholder="Ej: Martínez" required />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Especialidad" class="form-label">Especialidad</label>
                        <input asp-for="Especialidad" class="form-control" placeholder="Ej: Cardiología" required />
                        <span asp-validation-for="Especialidad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NumeroLicencia" class="form-label">Número de Licencia</label>
                        <input asp-for="NumeroLicencia" class="form-control" placeholder="Ej: MED-001" required />
                        <span asp-validation-for="NumeroLicencia" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            💾 Guardar Médico
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            ← Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
