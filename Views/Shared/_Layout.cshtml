<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MediApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border: none; background: rgba(0,0,0,0.05); padding: 0.5rem 0.75rem; border-radius: 8px;">
                    <span style="font-size: 1.5rem;">☰</span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
                               asp-area="" asp-controller="Home" asp-action="Index">
                                🏠 Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cita" ? "active" : "")" 
                               asp-area="" asp-controller="Cita" asp-action="Index">
                                📅 Citas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Paciente" ? "active" : "")" 
                               asp-area="" asp-controller="Paciente" asp-action="Index">
                                👥 Pacientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Medico" ? "active" : "")" 
                               asp-area="" asp-controller="Medico" asp-action="Index">
                                👨‍⚕️ Médicos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="fade-in">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem;">⚕️ MediApp - Sistema de Gestión Médica</p>
            <p style="opacity: 0.8;">&copy; @DateTime.Now.Year - Todos los derechos reservados</p>
            <p style="opacity: 0.7; font-size: 0.9rem;">Gestión eficiente de citas, pacientes y personal médico</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
